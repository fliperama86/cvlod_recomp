# OS metadata
.DS_Store

# Temporary files
*.log
*.tmp
.cache

# ROM (user-provided, not distributed)
resources/

# splat generated output (regenerated from ROM + YAML config)
asm/
assets/*
!assets/lod_icon-iOS-Default-1024x1024@1x.png
!assets/*.otf
!assets/*.ttf
!assets/*.rml
!assets/*.rcss
!assets/*.svg
!assets/config_menu/
!assets/config_menu/**
!assets/icons/
!assets/icons/**
!assets/promptfont/
!assets/promptfont/**
!assets/scss/
!assets/scss/**
build*/
castlevania2.ld
castlevania2.d
undefined_funcs_auto.txt
undefined_syms_auto.txt

# N64Recomp generated output (regenerated from ROM + config)
RecompiledFuncs/

# RecompiledFuncs backups (created by regen_recomp.sh)
backups/

# Local N64Recomp builds (use the known-good binary instead)
**/build_tool/

# Never commit ROMs or anything derived from them.
*.z64
*.n64
*.v64

# Android build output and machine-specific config
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
android/app/src/main/java/**/*.class

# Standalone test binaries built for on-device runs
/touchtest
/cheatstest
dist/
*.apk
*.apk.sha256
